{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "table-pet",
  "version": "0.1.0",
  "identifier": "com.table-pet.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "桌宠",
        "url": "index.html?window=pet",
        "width": 200,
        "height": 220,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "focus": false,
        "visible": true
      },
      {
        "label": "chat",
        "title": "桌宠聊天",
        "url": "index.html?window=chat",
        "width": 248,
        "height": 96,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "focus": false,
        "visible": false
      },
      {
        "label": "info",
        "title": "桌宠状态",
        "url": "index.html?window=info",
        "width": 240,
        "height": 144,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "visible": false
      },
      {
        "label": "reminder",
        "title": "桌宠提醒",
        "url": "index.html?window=reminder",
        "width": 248,
        "height": 132,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "focus": true,
        "visible": false
      },
      {
        "label": "settings",
        "title": "桌宠设置",
        "url": "index.html?window=settings",
        "width": 500,
        "height": 560,
        "minWidth": 460,
        "minHeight": 520,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "resizable": true,
        "skipTaskbar": true,
        "focus": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
